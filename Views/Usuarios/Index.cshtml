@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ECOTRACK</title>
    <!-- Logotipo en la pestaña del navegador -->
    <link rel="icon" type="image/png" href="~/img/logo.png" asp-append-version="true" />
    <link rel="shortcut icon" type="image/png" href="~/img/logo.png" asp-append-version="true" />

    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
                font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            }

            body {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                background: radial-gradient(circle at top left, #e8f5e9 0%, #dcedc8 45%, #c8e6c9 100%);
                padding: 20px;
            }

            .login-card {
                background: #ffffff;
                width: 100%;
                max-width: 420px;
                border-radius: 24px;
                padding: 36px 34px 32px;
                box-shadow: 0 20px 45px rgba(20, 61, 31, 0.12);
                border: 1px solid rgba(46, 125, 50, 0.14);
                text-align: center;
                position: relative;
                overflow: hidden;
            }

                .login-card::before {
                    content: "";
                    position: absolute;
                    top: 0;
                    left: 0;
                    right: 0;
                    height: 6px;
                    background: linear-gradient(90deg, #22c55e, #1b5e20);
                }

            .logo-wrapper {
                width: 115px;
                height: 115px;
                margin: 0 auto 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: radial-gradient(circle, #f0fdf4 0%, #ffffff 75%);
                border-radius: 50%;
            }

                .logo-wrapper img {
                    width: 105px;
                    height: 105px;
                    object-fit: contain;
                    mix-blend-mode: multiply;
                    filter: drop-shadow(0 4px 8px rgba(27, 94, 32, 0.10));
                }

            .subtitle {
                font-size: 13.5px;
                color: #4b6352;
                font-weight: 600;
                margin-bottom: 24px;
                padding-bottom: 16px;
                border-bottom: 1px solid #edf4ee;
            }

            .form-group {
                text-align: left;
                margin-bottom: 18px;
            }

                .form-group label {
                    display: block;
                    font-size: 12.5px;
                    font-weight: 700;
                    color: #143319;
                    margin-bottom: 6px;
                }

            .input-box {
                position: relative;
                display: flex;
                align-items: center;
            }

            .input-icon {
                position: absolute;
                left: 14px;
                color: #64748b;
                display: flex;
                align-items: center;
                pointer-events: none;
            }

            .input-box input {
                width: 100%;
                padding: 12px 40px 12px 40px;
                border: 1.5px solid #d8e2dc;
                border-radius: 12px;
                font-size: 13.5px;
                color: #1e293b;
                background-color: #f8faf9;
                outline: none;
                transition: all 0.2s ease;
            }

                .input-box input:focus {
                    background-color: #ffffff;
                    border-color: #2e7d32;
                    box-shadow: 0 0 0 4px rgba(46, 125, 50, 0.12);
                }

            .toggle-password {
                position: absolute;
                right: 12px;
                background: none;
                border: none;
                cursor: pointer;
                color: #64748b;
                display: flex;
                align-items: center;
                padding: 4px;
            }

                .toggle-password:hover {
                    color: #1b5e20;
                }

            .forgot-link-row {
                text-align: right;
                margin-top: -10px;
                margin-bottom: 16px;
            }

                .forgot-link-row a {
                    font-size: 12.5px;
                    color: #1b5e20;
                    font-weight: 600;
                    text-decoration: none;
                }

                    .forgot-link-row a:hover {
                        text-decoration: underline;
                    }

            .btn-submit {
                width: 100%;
                padding: 13px;
                background: linear-gradient(135deg, #2e7d32 0%, #1b5e20 100%);
                color: #ffffff;
                border: none;
                border-radius: 12px;
                font-size: 14.5px;
                font-weight: 700;
                cursor: pointer;
                margin-top: 6px;
                box-shadow: 0 8px 18px rgba(27, 94, 32, 0.24);
                transition: transform 0.15s ease, box-shadow 0.15s ease;
            }

                .btn-submit:hover {
                    transform: translateY(-1px);
                    box-shadow: 0 12px 22px rgba(27, 94, 32, 0.32);
                }

                .btn-submit:disabled {
                    opacity: 0.7;
                    cursor: not-allowed;
                    transform: none;
                }

            .alert-error {
                background: #fde8e8;
                color: #9b1c1c;
                border: 1px solid #f8b4b4;
                padding: 10px 12px;
                border-radius: 12px;
                font-size: 12.5px;
                margin-bottom: 16px;
                text-align: left;
            }

            .alert-success {
                background: #ecfdf5;
                color: #166534;
                border: 1px solid #86efac;
                padding: 10px 12px;
                border-radius: 12px;
                font-size: 12.5px;
                margin-bottom: 16px;
                text-align: left;
            }

            .bottom-link {
                font-size: 13px;
                color: #64748b;
                margin-top: 22px;
            }

                .bottom-link a {
                    color: #1b5e20;
                    font-weight: 700;
                    text-decoration: none;
                }

                    .bottom-link a:hover {
                        text-decoration: underline;
                    }

            /* Modal Recuperar Contraseña */
            .modal-overlay {
                position: fixed;
                inset: 0;
                background: rgba(15, 35, 20, 0.55);
                backdrop-filter: blur(3px);
                display: none;
                align-items: center;
                justify-content: center;
                padding: 20px;
                z-index: 1000;
            }

                .modal-overlay.activo {
                    display: flex;
                }

            .modal-box {
                background: #ffffff;
                width: 100%;
                max-width: 400px;
                border-radius: 20px;
                padding: 28px 26px 24px;
                box-shadow: 0 22px 50px rgba(0, 0, 0, 0.22);
                position: relative;
                text-align: left;
            }

            .modal-close {
                position: absolute;
                top: 14px;
                right: 16px;
                background: none;
                border: none;
                font-size: 22px;
                color: #64748b;
                cursor: pointer;
                line-height: 1;
            }

                .modal-close:hover {
                    color: #1b5e20;
                }

            .modal-title {
                font-size: 18px;
                font-weight: 800;
                color: #1b5e20;
                margin-bottom: 6px;
            }

            .modal-desc {
                font-size: 13px;
                color: #4b6352;
                margin-bottom: 18px;
                line-height: 1.4;
            }

            .input-simple {
                width: 100%;
                padding: 11px 14px;
                border: 1.5px solid #d8e2dc;
                border-radius: 12px;
                font-size: 13.5px;
                color: #1e293b;
                background-color: #f8faf9;
                outline: none;
            }

                .input-simple:focus {
                    background-color: #ffffff;
                    border-color: #2e7d32;
                    box-shadow: 0 0 0 4px rgba(46, 125, 50, 0.12);
                }

            .input-codigo {
                text-align: center;
                font-size: 20px;
                font-weight: 700;
                letter-spacing: 6px;
            }

            .btn-secundario {
                width: 100%;
                padding: 10px;
                margin-top: 10px;
                background: #f1f5f9;
                color: #334155;
                border: none;
                border-radius: 10px;
                font-size: 13px;
                font-weight: 600;
                cursor: pointer;
            }

                .btn-secundario:hover {
                    background: #e2e8f0;
                }
    </style>
</head>
<body>

    <div class="login-card">
        <div class="logo-wrapper">
            <img src="/img/logo.png" alt="Logo EcoTrack" />
        </div>

        <div class="subtitle">Plataforma Comunitaria de Monitoreo Ambiental</div>

        @if (ViewBag.Error != null)
        {
            <div class="alert-error">⚠️ @ViewBag.Error</div>
        }

        <form method="post" action="/Usuarios/Login">
            <div class="form-group">
                <label>Correo Electrónico</label>
                <div class="input-box">
                    <span class="input-icon">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
                    </span>
                    <input type="email" name="correo" required placeholder="tu.correo@ejemplo.com" />
                </div>
            </div>

            <div class="form-group">
                <label>Contraseña</label>
                <div class="input-box">
                    <span class="input-icon">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                    </span>
                    <input type="password" id="loginPass" name="contrasena" required minlength="8" placeholder="Mínimo 8 caracteres" />
                    <button type="button" class="toggle-password" onclick="verPassword('loginPass')">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    </button>
                </div>
            </div>

            <div class="forgot-link-row">
                <a href="javascript:void(0)" onclick="abrirModalRecuperar()">¿Olvidaste tu contraseña?</a>
            </div>

            <button type="submit" class="btn-submit">Iniciar Sesión &rarr;</button>
        </form>

        <div class="bottom-link">
            ¿Aún no tienes una cuenta? <a href="/Usuarios/Registro">Regístrate aquí</a>
        </div>
    </div>

    <!-- Modal de Recuperación de Contraseña -->
    <div id="modalRecuperar" class="modal-overlay">
        <div class="modal-box">
            <button type="button" class="modal-close" onclick="cerrarModalRecuperar()">&times;</button>
            <div class="modal-title">Recuperar Contraseña</div>

            <div id="recMensaje" style="display:none;"></div>

            <!-- Paso 1: Ingresar correo -->
            <div id="paso1Correo">
                <p class="modal-desc">Ingresa el correo registrado en tu cuenta y te enviaremos un código de 6 dígitos.</p>
                <div class="form-group">
                    <label>Correo Electrónico</label>
                    <input type="email" id="recCorreo" class="input-simple" placeholder="tu.correo@ejemplo.com" />
                </div>
                <button type="button" id="btnEnviarCodigo" class="btn-submit" onclick="enviarCodigoRecuperacion()">
                    Enviar Código
                </button>
            </div>

            <!-- Paso 2: Ingresar código y nueva contraseña -->
            <div id="paso2Restablecer" style="display:none;">
                <p class="modal-desc">Ingresa el código de 6 dígitos que enviamos a tu correo y define tu nueva contraseña.</p>

                <div class="form-group">
                    <label>Código de 6 dígitos</label>
                    <input type="text" id="recCodigo" class="input-simple input-codigo" maxlength="6" placeholder="000000" />
                </div>

                <div class="form-group">
                    <label>Nueva Contraseña</label>
                    <div class="input-box">
                        <input type="password" id="recNuevaPass" class="input-simple" style="padding-right: 40px;" placeholder="Mín. 8 caracteres, Mayús, Minús y Número" />
                        <button type="button" class="toggle-password" onclick="verPassword('recNuevaPass')">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                        </button>
                    </div>
                </div>

                <div class="form-group">
                    <label>Confirmar Nueva Contraseña</label>
                    <input type="password" id="recConfirmarPass" class="input-simple" placeholder="Repite tu nueva contraseña" />
                </div>

                <button type="button" id="btnGuardarPass" class="btn-submit" onclick="restablecerContrasena()">
                    Guardar Nueva Contraseña
                </button>
                <button type="button" class="btn-secundario" onclick="volverAPaso1()">
                    Cambiar correo o reenviar código
                </button>
            </div>
        </div>
    </div>

    <script>
            function verPassword(idInput) {
                const input = document.getElementById(idInput);
                input.type = input.type === 'password' ? 'text' : 'password';
            }

            function mostrarMensajeRec(texto, esExito) {
                const box = document.getElementById('recMensaje');
                box.className = esExito ? 'alert-success' : 'alert-error';
                box.textContent = texto;
                box.style.display = 'block';
            }

            function limpiarMensajeRec() {
                const box = document.getElementById('recMensaje');
                box.style.display = 'none';
                box.textContent = '';
            }

            function abrirModalRecuperar() {
                limpiarMensajeRec();
                document.getElementById('paso1Correo').style.display = 'block';
                document.getElementById('paso2Restablecer').style.display = 'none';
                document.getElementById('recCodigo').value = '';
                document.getElementById('recNuevaPass').value = '';
                document.getElementById('recConfirmarPass').value = '';
                document.getElementById('modalRecuperar').classList.add('activo');
            }

            function cerrarModalRecuperar() {
                document.getElementById('modalRecuperar').classList.remove('activo');
            }

            function volverAPaso1() {
                limpiarMensajeRec();
                document.getElementById('paso1Correo').style.display = 'block';
                document.getElementById('paso2Restablecer').style.display = 'none';
            }

            async function enviarCodigoRecuperacion() {
                limpiarMensajeRec();
                const correo = document.getElementById('recCorreo').value.trim();
                if (!correo) {
                    mostrarMensajeRec('Por favor ingresa tu correo electrónico.', false);
                    return;
                }

                const btn = document.getElementById('btnEnviarCodigo');
                btn.disabled = true;
                btn.textContent = 'Enviando código...';

                try {
                    const res = await fetch('/Usuarios/EnviarCodigoRecuperacion', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: new URLSearchParams({ correo })
                    });
                    const data = await res.json();

                    if (data.ok) {
                        mostrarMensajeRec(data.mensaje, true);
                        document.getElementById('paso1Correo').style.display = 'none';
                        document.getElementById('paso2Restablecer').style.display = 'block';
                    } else {
                        mostrarMensajeRec(data.mensaje, false);
                    }
                } catch (e) {
                    mostrarMensajeRec('Error de conexión con el servidor.', false);
                } finally {
                    btn.disabled = false;
                    btn.textContent = 'Enviar Código';
                }
            }

            async function restablecerContrasena() {
                limpiarMensajeRec();
                const codigo = document.getElementById('recCodigo').value.trim();
                const nuevaContrasena = document.getElementById('recNuevaPass').value.trim();
                const confirmar = document.getElementById('recConfirmarPass').value.trim();

                if (!codigo || codigo.length !== 6) {
                    mostrarMensajeRec('Ingresa el código de 6 dígitos.', false);
                    return;
                }
                if (nuevaContrasena.length < 8) {
                    mostrarMensajeRec('La contraseña debe tener al menos 8 caracteres.', false);
                    return;
                }
                if (nuevaContrasena !== confirmar) {
                    mostrarMensajeRec('Las contraseñas no coinciden.', false);
                    return;
                }

                const btn = document.getElementById('btnGuardarPass');
                btn.disabled = true;
                btn.textContent = 'Actualizando...';

                try {
                    const res = await fetch('/Usuarios/RestablecerContrasena', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: new URLSearchParams({ codigo, nuevaContrasena })
                    });
                    const data = await res.json();

                    if (data.ok) {
                        mostrarMensajeRec(data.mensaje, true);
                        setTimeout(() => {
                            cerrarModalRecuperar();
                        }, 1800);
                    } else {
                        mostrarMensajeRec(data.mensaje, false);
                    }
                } catch (e) {
                    mostrarMensajeRec('Error de conexión con el servidor.', false);
                } finally {
                    btn.disabled = false;
                    btn.textContent = 'Guardar Nueva Contraseña';
                }
            }
    </script>
</body>
</html>