@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ECOTRACK</title>
    <!-- Logotipo en la pestaña del navegador -->
    <link rel="icon" type="image/png" href="~/img/logo.png" asp-append-version="true" />
    <link rel="shortcut icon" type="image/png" href="~/img/logo.png" asp-append-version="true" />

    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; }
        
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: radial-gradient(circle at top left, #e8f5e9 0%, #dcedc8 45%, #c8e6c9 100%);
            padding: 20px;
        }

        .login-card {
            background: #ffffff;
            width: 100%;
            max-width: 420px;
            border-radius: 24px;
            padding: 36px 34px 32px;
            box-shadow: 0 20px 45px rgba(20, 61, 31, 0.12);
            border: 1px solid rgba(46, 125, 50, 0.14);
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .login-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 6px;
            background: linear-gradient(90deg, #22c55e, #1b5e20);
        }

        .logo-wrapper {
            width: 115px;
            height: 115px;
            margin: 0 auto 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: radial-gradient(circle, #f0fdf4 0%, #ffffff 75%);
            border-radius: 50%;
        }

        .logo-wrapper img {
            width: 105px;
            height: 105px;
            object-fit: contain;
            mix-blend-mode: multiply;
            filter: drop-shadow(0 4px 8px rgba(27, 94, 32, 0.10));
        }

        .subtitle {
            font-size: 13.5px;
            color: #4b6352;
            font-weight: 600;
            margin-bottom: 24px;
            padding-bottom: 16px;
            border-bottom: 1px solid #edf4ee;
        }

        .form-group {
            text-align: left;
            margin-bottom: 18px;
        }

        .form-group label {
            display: block;
            font-size: 12.5px;
            font-weight: 700;
            color: #143319;
            margin-bottom: 6px;
        }

        .input-box {
            position: relative;
            display: flex;
            align-items: center;
        }

        .input-icon {
            position: absolute;
            left: 14px;
            color: #64748b;
            display: flex;
            align-items: center;
            pointer-events: none;
        }

        .input-box input {
            width: 100%;
            padding: 12px 40px 12px 40px;
            border: 1.5px solid #d8e2dc;
            border-radius: 12px;
            font-size: 13.5px;
            color: #1e293b;
            background-color: #f8faf9;
            outline: none;
            transition: all 0.2s ease;
        }

        .input-box input:focus {
            background-color: #ffffff;
            border-color: #2e7d32;
            box-shadow: 0 0 0 4px rgba(46, 125, 50, 0.12);
        }

        .toggle-password {
            position: absolute;
            right: 12px;
            background: none;
            border: none;
            cursor: pointer;
            color: #64748b;
            display: flex;
            align-items: center;
            padding: 4px;
        }

        .toggle-password:hover { color: #1b5e20; }

        .btn-submit {
            width: 100%;
            padding: 13px;
            background: linear-gradient(135deg, #2e7d32 0%, #1b5e20 100%);
            color: #ffffff;
            border: none;
            border-radius: 12px;
            font-size: 14.5px;
            font-weight: 700;
            cursor: pointer;
            margin-top: 6px;
            box-shadow: 0 8px 18px rgba(27, 94, 32, 0.24);
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }

        .btn-submit:hover {
            transform: translateY(-1px);
            box-shadow: 0 12px 22px rgba(27, 94, 32, 0.32);
        }

        .alert-error {
            background: #fde8e8;
            color: #9b1c1c;
            border: 1px solid #f8b4b4;
            padding: 10px 12px;
            border-radius: 12px;
            font-size: 12.5px;
            margin-bottom: 16px;
            text-align: left;
        }

        .bottom-link {
            font-size: 13px;
            color: #64748b;
            margin-top: 22px;
        }

        .bottom-link a {
            color: #1b5e20;
            font-weight: 700;
            text-decoration: none;
        }

        .bottom-link a:hover { text-decoration: underline; }
    </style>
</head>
<body>

    <div class="login-card">
        <div class="logo-wrapper">
            <img src="/img/logo.png" alt="Logo EcoTrack" />
        </div>

        <div class="subtitle">Plataforma Comunitaria de Monitoreo Ambiental</div>

        @if (ViewBag.Error != null)
        {
            <div class="alert-error">⚠️ @ViewBag.Error</div>
        }

        <form method="post" action="/Usuarios/Login">
            <div class="form-group">
                <label>Correo Electrónico</label>
                <div class="input-box">
                    <span class="input-icon">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
                    </span>
                    <input type="email" name="correo" required placeholder="tu.correo@ejemplo.com" />
                </div>
            </div>

            <div class="form-group">
                <label>Contraseña</label>
                <div class="input-box">
                    <span class="input-icon">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                    </span>
                    <input type="password" id="loginPass" name="contrasena" required minlength="8" placeholder="Mínimo 8 caracteres" />
                    <button type="button" class="toggle-password" onclick="verPassword()">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    </button>
                </div>
            </div>

            <button type="submit" class="btn-submit">Iniciar Sesión &rarr;</button>
        </form>

        <div class="bottom-link">
            ¿Aún no tienes una cuenta? <a href="/Usuarios/Registro">Regístrate aquí</a>
        </div>
    </div>

    <script>
        function verPassword() {
            const input = document.getElementById('loginPass');
            input.type = input.type === 'password' ? 'text' : 'password';
        }
    </script>
</body>
</html>