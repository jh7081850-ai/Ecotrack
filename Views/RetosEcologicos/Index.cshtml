@{
    Layout = null;
    var nombre = ViewBag.UsuarioNombre ?? "Administrador";
    var iniciales = ViewBag.UsuarioIniciales ?? "AD";
    var rol = ViewBag.UsuarioRol ?? "Administrador";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Retos Ecológicos - ECOTRACK</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', system-ui, sans-serif; }
        body { display: flex; height: 100vh; background: #f4fbf5; color: #143319; }
        .sidebar { width: 260px; min-width: 260px; background: #ffffff; border-right: 1px solid #d9e7dc; display: flex; flex-direction: column; justify-content: space-between; }
        .brand-header { padding: 22px; font-size: 20px; font-weight: 800; color: #1b5e20; }
        .user-card { display: flex; align-items: center; gap: 12px; margin: 0 16px 20px; padding: 12px 14px; background: #e8f5e9; border-radius: 12px; }
        .user-avatar { width: 38px; height: 38px; border-radius: 50%; background: #2e7d32; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; }
        .menu-heading { font-size: 10.5px; font-weight: 700; color: #76a880; padding: 12px 22px 6px; }
        .menu-link { display: flex; align-items: center; gap: 12px; padding: 10px 22px; color: #385e3c; text-decoration: none; font-size: 13.5px; font-weight: 600; }
        .menu-link:hover { background: #f0f7f1; }
        .menu-link.active { background: #e8f5e9; color: #1b5e20; border-left: 4px solid #2e7d32; font-weight: 700; }
        .main-content { flex: 1; overflow-y: auto; padding: 28px 34px; }
        .topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
        .btn-green { background: #2e7d32; color: #fff; border: none; padding: 9px 16px; border-radius: 8px; font-weight: 700; cursor: pointer; }
        .cards-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 20px; }
        .reto-card { background: #fff; border: 1px solid #d9e7dc; border-radius: 14px; padding: 20px; box-shadow: 0 2px 6px rgba(0,0,0,0.02); }
        .reto-points { background: #e8f5e9; color: #1b5e20; padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 800; display: inline-block; margin-bottom: 10px; }
        .modal { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000; }
        .modal-box { background: #fff; border-radius: 14px; padding: 24px; width: 440px; }
        .form-row { margin-bottom: 12px; display: flex; flex-direction: column; gap: 5px; }
        .form-row input, .form-row textarea { padding: 8px 12px; border: 1.5px solid #c8e6c9; border-radius: 6px; }
    </style>
</head>
<body>
<aside class="sidebar">
    <div>
        <div class="brand-header">ECOTRACK</div>
        <div class="user-card">
            <div class="user-avatar">@iniciales</div>
            <div>
                <div style="font-size:13.5px; font-weight:700; color:#1b5e20;">@nombre</div>
                <div style="font-size:11.5px; color:#4e7d55;">@rol</div>
            </div>
        </div>
        <div class="menu-heading">MONITOREO & MAPA</div>
        <a href="/Reportes/Index" class="menu-link">🗺️ Mapa de Reportes</a>
        <div class="menu-heading">ADMINISTRACIÓN & TABLAS</div>
        <a href="/Usuarios/Lista" class="menu-link">👥 Usuarios</a>
        <a href="/RetosEcologicos/Index" class="menu-link active">🌱 Retos Ecológicos</a>
        <a href="/ParticipantesRetos/Index" class="menu-link">🤝 Participantes Retos</a>
        <a href="/HistorialPuntos/Index" class="menu-link">🏆 Historial de Puntos</a>
    </div>
    <div style="padding: 18px 22px; border-top: 1px solid #edf4ee;">
        <a href="/Usuarios/Index" style="color: #c62828; text-decoration:none; font-size:13px; font-weight:600;">🚪 Cerrar Sesión</a>
    </div>
</aside>

<main class="main-content">
    <div class="topbar">
        <div>
            <h2 style="font-size: 22px; color: #1b5e20;">Catálogo de Retos Comunitarios</h2>
            <p style="font-size: 13px; color: #4e7d55;">Iniciativas ambientales activas en Tecámac</p>
        </div>
        <button class="btn-green" onclick="document.getElementById('modalReto').style.display='flex'">+ Nuevo Reto</button>
    </div>

    <div class="cards-grid">
        @if (ViewBag.Retos != null)
        {
            foreach (var r in ViewBag.Retos)
            {
                <div class="reto-card">
                    <span class="reto-points">+@r.Puntos Puntos</span>
                    <h3 style="font-size: 16px; color:#1b5e20; margin-bottom: 6px;">@r.Titulo</h3>
                    <p style="font-size: 13px; color: #4b6f52; margin-bottom: 12px;">@r.Descripcion</p>
                    <div style="font-size: 12px; color: #76a880; font-weight:600;">
                        Vigencia: @r.Inicio al @r.Fin
                    </div>
                </div>
            }
        }
    </div>
</main>

<div class="modal" id="modalReto">
    <div class="modal-box">
        <h3 style="color:#1b5e20; margin-bottom:14px;">Crear Reto Ambiental</h3>
        <form action="/RetosEcologicos/Crear" method="post">
            <div class="form-row">
                <label style="font-size:12px; font-weight:700;">Nombre del Reto</label>
                <input type="text" name="nombre_reto" required placeholder="Ej: Reforestación Sierra Hermosa" />
            </div>
            <div class="form-row">
                <label style="font-size:12px; font-weight:700;">Descripción</label>
                <textarea name="descripcion" rows="3" required placeholder="Detalles del objetivo..."></textarea>
            </div>
            <div class="form-row">
                <label style="font-size:12px; font-weight:700;">Puntos a otorgar</label>
                <input type="number" name="puntos" required value="100" />
            </div>
            <div style="display:flex; gap:10px;">
                <div class="form-row" style="flex:1;">
                    <label style="font-size:12px; font-weight:700;">Fecha Inicio</label>
                    <input type="date" name="fecha_inicio" required />
                </div>
                <div class="form-row" style="flex:1;">
                    <label style="font-size:12px; font-weight:700;">Fecha Fin</label>
                    <input type="date" name="fecha_fin" required />
                </div>
            </div>
            <div style="display:flex; justify-content:flex-end; gap:8px; margin-top:14px;">
                <button type="button" onclick="document.getElementById('modalReto').style.display='none'" style="padding:8px 12px; border:none; background:#eee; border-radius:6px; cursor:pointer;">Cancelar</button>
                <button type="submit" class="btn-green">Guardar Reto</button>
            </div>
        </form>
    </div>
</div>
</body>
</html>