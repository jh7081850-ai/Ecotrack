@{
    Layout = null;
    var nombre = ViewBag.UsuarioNombre ?? "Administrador";
    var iniciales = ViewBag.UsuarioIniciales ?? "AD";
    var rol = ViewBag.UsuarioRol ?? "Administrador";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Panel de Control General - ECOTRACK</title>
    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
                font-family: 'Segoe UI', system-ui, sans-serif;
            }

            body {
                display: flex;
                height: 100vh;
                background: #f4fbf5;
                color: #143319;
            }

            .sidebar {
                width: 260px;
                min-width: 260px;
                background: #0f2d18;
                color: #fff;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
            }

            .brand-header {
                padding: 22px;
                font-size: 20px;
                font-weight: 800;
                color: #a3e635;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .tag-consola {
                background: #164e28;
                color: #a3e635;
                font-size: 10px;
                padding: 3px 8px;
                border-radius: 6px;
                font-weight: 700;
            }

            .user-card {
                display: flex;
                align-items: center;
                gap: 12px;
                margin: 0 16px 20px;
                padding: 12px 14px;
                background: #143e20;
                border-radius: 12px;
            }

            .user-avatar {
                width: 38px;
                height: 38px;
                border-radius: 50%;
                background: #22c55e;
                color: #064e1e;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 800;
            }

            .menu-heading {
                font-size: 10px;
                font-weight: 700;
                color: #6ee7b7;
                padding: 12px 22px 6px;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

            .menu-link {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 10px 22px;
                color: #d1fae5;
                text-decoration: none;
                font-size: 13.5px;
                font-weight: 600;
            }

                .menu-link:hover {
                    background: #164e28;
                    color: #fff;
                }

                .menu-link.active {
                    background: #22c55e;
                    color: #064e1e;
                    font-weight: 800;
                    border-radius: 8px;
                    margin: 0 12px;
                    padding: 10px 14px;
                }

            .main-content {
                flex: 1;
                overflow-y: auto;
                padding: 28px 34px;
            }

            .top-bar {
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                margin-bottom: 24px;
            }

            .btn-map {
                background: #1b5e20;
                color: #fff;
                padding: 10px 18px;
                border-radius: 8px;
                text-decoration: none;
                font-weight: 700;
                font-size: 13px;
            }

            .kpi-row {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 18px;
                margin-bottom: 28px;
            }

            .kpi-card {
                background: #fff;
                border-radius: 14px;
                padding: 20px;
                border: 1px solid #d9e7dc;
                box-shadow: 0 2px 6px rgba(0,0,0,0.03);
            }

            .kpi-label {
                font-size: 11px;
                font-weight: 700;
                color: #4e7d55;
                text-transform: uppercase;
            }

            .kpi-number {
                font-size: 32px;
                font-weight: 800;
                color: #143319;
                margin: 6px 0;
            }

            .kpi-sub {
                font-size: 12px;
                font-weight: 600;
                color: #2e7d32;
            }

            .panel-box {
                background: #fff;
                border-radius: 14px;
                border: 1px solid #d9e7dc;
                padding: 22px;
                box-shadow: 0 2px 8px rgba(0,0,0,0.03);
            }

            table {
                width: 100%;
                border-collapse: collapse;
                font-size: 13.5px;
                margin-top: 15px;
            }

            th, td {
                padding: 12px 14px;
                text-align: left;
                border-bottom: 1px solid #edf4ee;
                vertical-align: middle;
            }

            th {
                background: #f4fbf5;
                color: #2e5934;
                font-weight: 700;
            }

            .badge {
                padding: 4px 10px;
                border-radius: 20px;
                font-size: 11px;
                font-weight: 700;
                display: inline-block;
            }

            .b-pendiente {
                background: #fef3c7;
                color: #b45309;
            }

            .b-proceso {
                background: #e0f2fe;
                color: #0369a1;
            }

            .b-resuelto {
                background: #dcfce7;
                color: #15803d;
            }

            .btn-action {
                padding: 6px 12px;
                border-radius: 6px;
                font-weight: 700;
                font-size: 12px;
                cursor: pointer;
                border: 1px solid #143319;
                background: #fff;
                text-decoration: none;
                color: #143319;
            }

                .btn-action:hover {
                    background: #143319;
                    color: #fff;
                }

            .btn-validar {
                padding: 6px 12px;
                border-radius: 6px;
                font-weight: 700;
                font-size: 12px;
                cursor: pointer;
                border: none;
                background: #1b5e20;
                color: #fff;
            }

                .btn-validar:hover {
                    background: #143e20;
                }

            .modal-overlay {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,0.55);
                z-index: 2000;
                justify-content: center;
                align-items: center;
                padding: 15px;
            }

            .modal-card {
                background: #fff;
                width: 100%;
                max-width: 500px;
                border-radius: 16px;
                padding: 24px;
                position: relative;
                max-height: 92vh;
                overflow-y: auto;
            }

            .modal-card-wide {
                background: #fff;
                width: 100%;
                max-width: 760px;
                border-radius: 16px;
                padding: 26px;
                position: relative;
                max-height: 92vh;
                overflow-y: auto;
            }

            .modal-close {
                position: absolute;
                top: 16px;
                right: 18px;
                font-size: 22px;
                border: none;
                background: transparent;
                cursor: pointer;
                font-weight: bold;
                color: #555;
            }

            .form-group {
                margin-bottom: 14px;
            }

                .form-group label {
                    display: block;
                    font-size: 12px;
                    font-weight: 700;
                    margin-bottom: 4px;
                    color: #2e5934;
                }

                .form-group input, .form-group select {
                    width: 100%;
                    padding: 9px 12px;
                    border: 1px solid #c8e6c9;
                    border-radius: 8px;
                    font-size: 13px;
                }

            .btn-submit {
                width: 100%;
                padding: 11px;
                background: #1b5e20;
                color: #fff;
                border: none;
                border-radius: 8px;
                font-weight: 700;
                cursor: pointer;
            }

            .comparativa-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 18px;
                margin-top: 16px;
            }

            .comparativa-box {
                padding: 14px;
                border-radius: 12px;
                text-align: center;
            }

                .comparativa-box img {
                    width: 100%;
                    height: 240px;
                    object-fit: cover;
                    border-radius: 8px;
                    margin-top: 8px;
                    background: #f1f5f9;
                }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div>
            <div class="brand-header">
                ECOTRACK <span class="tag-consola">CONSOLA</span>
            </div>
            <div class="user-card">
                <div class="user-avatar">@iniciales</div>
                <div>
                    <div style="font-size:13.5px; font-weight:700; color:#fff;">@nombre</div>
                    <div style="font-size:10.5px; color:#a3e635; font-weight:700;">@rol</div>
                </div>
            </div>
            <div class="menu-heading">Centro de Mando</div>
            <a href="/Admin/Index" class="menu-link active">📊 Tablero Resumen</a>
            <a href="/Reportes/Index" class="menu-link">🗺️ Vista Ciudadana / Mapa</a>

            <div class="menu-heading">Control de Base de Datos</div>
            <a href="/Admin/Usuarios" class="menu-link">👥 Auditoría de Usuarios</a>
            <a href="/Admin/Retos" class="menu-link">🌱 Catálogo de Retos</a>
            <a href="/Admin/Participantes" class="menu-link">🤝 Registro Participantes</a>
            <a href="/Admin/Puntos" class="menu-link">🏆 Control de Puntos</a>
        </div>
        <div style="padding: 18px 22px; border-top: 1px solid #143e20;">
            <a href="/Usuarios/CerrarSesion" style="color: #f87171; text-decoration:none; font-size:13px; font-weight:600;">🚪 Cerrar Sesión</a>
        </div>
    </aside>

    <main class="main-content">
        <div class="top-bar">
            <div>
                <h2 style="font-size: 24px; color: #1b5e20;">Panel de Control General</h2>
                <p style="font-size: 13px; color: #4e7d55;">Supervisión de registros, validación de retos para publicación en mapa y base de datos</p>
            </div>
            <a href="/Reportes/Index" class="btn-map">Ir al Mapa Territorial</a>
        </div>

        <div class="kpi-row">
            <div class="kpi-card">
                <div class="kpi-label">Usuarios en el Sistema</div>
                <div class="kpi-number">@ViewBag.TotalUsuarios</div>
                <div class="kpi-sub">Registros reales en Neon</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">Reportes por Validar</div>
                <div class="kpi-number" style="color: #b45309;">@ViewBag.ReportesSinAtender</div>
                <div class="kpi-sub">En espera de aprobación</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">Retos Publicados</div>
                <div class="kpi-number">@ViewBag.RetosActivos</div>
                <div class="kpi-sub">Visibles en el mapa</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">Motor Neon PostgreSQL</div>
                <div class="kpi-number" style="font-size:22px; color:#15803d; margin-top:12px;">@ViewBag.EstadoConexion</div>
                <div class="kpi-sub">Servicio Cloud Activo</div>
            </div>
        </div>

        <div class="panel-box">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <h3 style="font-size: 17px; color: #1b5e20;">Monitoreo y Validación de Incidencias Comunitarias</h3>
                <a href="/Admin/Index" style="text-decoration:none; background:#f4fbf5; border:1px solid #c8e6c9; padding:6px 14px; border-radius:6px; font-size:12px; font-weight:700; color:#1b5e20;">Actualizar</a>
            </div>

            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Incidencia</th>
                        <th>Coordenadas</th>
                        <th>Estatus Reporte</th>
                        <th>Visibilidad en Mapa</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.Incidencias != null)
                    {
                        foreach (var inc in ViewBag.Incidencias)
                        {
                            string estLower = (inc.Estatus ?? "").ToString().ToLower();
                            string retoLower = (inc.EstadoReto ?? "").ToString().ToLower();
                            bool esConcluido = (estLower == "resuelto" || retoLower == "completado");
                            bool requiereValidacion = !esConcluido && (estLower == "pendiente" || estLower == "por validar" || retoLower == "por validar");

                            var badgeClase = esConcluido ? "b-resuelto" : (requiereValidacion ? "b-pendiente" : "b-proceso");

                            <tr>
                                <td>#@inc.Id</td>
                                <td>
                                    <b>@inc.Titulo</b><br />
                                    <span style="font-size:11.5px; color:#666;">@inc.Descripcion</span>
                                </td>
                                <td>@inc.Coordenadas</td>
                                <td><span class="badge @badgeClase">@inc.Estatus</span></td>
                                <td>
                                    @if (esConcluido)
                                    {
                                        <span class="badge b-resuelto">✓ Reto Concluido</span>
                                    }
                                    else if (requiereValidacion)
                                    {
                                        <span class="badge b-pendiente">⏳ En espera de validar</span>
                                    }
                                    else
                                    {
                                        <span class="badge b-proceso">🗺️ Publicado en Mapa</span>
                                    }
                                </td>
                                <td>
                                    <div style="display:flex; gap:8px; align-items:center;">
                                        @if (requiereValidacion)
                                        {
                                            <form method="post" action="/Admin/ValidarYPublicarEnMapa" style="margin:0;">
                                                <input type="hidden" name="id_reporte" value="@inc.Id" />
                                                <button type="submit" class="btn-validar"
                                                        onclick="return confirm('¿Aprobar esta incidencia y publicar su reto ecológico en el mapa ciudadano?');">
                                                    ✓ Validar y Publicar
                                                </button>
                                            </form>
                                        }

                                        @if (esConcluido)
                                        {
                                            <!-- Si ya está Resuelto / Reto Concluido, Inspeccionar abre el Antes y Después -->
                                            <button type="button" class="btn-action"
                                                    onclick="abrirModalAntesDespues(@inc.Id, '@Html.Raw(inc.Titulo.Replace("'", "\\'"))', '@Html.Raw(inc.Reportante.Replace("'", "\\'"))', '@Html.Raw(inc.Solucionador.Replace("'", "\\'"))', '@inc.FotoInicial', '@inc.FotoSolucion')">
                                                Inspeccionar
                                            </button>
                                        }
                                        else
                                        {
                                            <!-- Si está por validar o en proceso, Inspeccionar abre la foto subida y el panel de validación -->
                                            <button type="button" class="btn-action"
                                                    onclick="abrirModalInspeccion(@inc.Id, '@Html.Raw(inc.Titulo.Replace("'", "\\'"))', '@inc.Estatus', @inc.IdUsuario, '@Html.Raw(inc.Reportante.Replace("'", "\\'"))', '@inc.FotoInicial')">
                                                Inspeccionar
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </main>

    <!-- MODAL 1: Para incidencias Pendientes / En espera de validar (Muestra la foto subida y formulario de validación) -->
    <div id="modalInspeccionar" class="modal-overlay">
        <div class="modal-card">
            <button class="modal-close" onclick="cerrarModalInspeccion()">&times;</button>
            <h3 style="color:#1b5e20; margin-bottom:4px;">Inspección y Validación</h3>
            <p id="txtIncidencia" style="font-size:13px; color:#555; margin-bottom:12px; font-weight:600;"></p>

            <div style="margin-bottom:14px; text-align:center; background:#f9fafb; padding:10px; border-radius:10px; border:1px solid #d9e7dc;">
                <span style="display:block; font-size:11.5px; font-weight:700; color:#2e5934; margin-bottom:6px;">📷 Imagen Subida en el Reporte</span>
                <img id="imgInspeccion" src="" alt="Evidencia subida" style="width:100%; max-height:210px; object-fit:cover; border-radius:8px; background:#e2e8f0;" />
            </div>

            <form method="post" action="/Admin/ActualizarEstatusYAsignarPuntos">
                <input type="hidden" id="modalIdReporte" name="id_reporte" />
                <input type="hidden" id="modalIdUsuario" name="id_usuario" />

                <div class="form-group">
                    <label>Actualizar Estatus (Al pasar a 'En Proceso' se publica en el Mapa)</label>
                    <select id="modalEstatus" name="nuevo_estatus">
                        <option value="Pendiente">Pendiente (En espera de validar)</option>
                        <option value="En Proceso">En Proceso (Validar y Publicar en Mapa)</option>
                        <option value="Resuelto">Resuelto (Reto Completado)</option>
                    </select>
                </div>

                <div class="form-group" style="background:#f4fbf5; padding:12px; border-radius:8px; border:1px solid #c8e6c9;">
                    <label style="color:#1b5e20;">🏆 Asignar Puntos al Reportante (<span id="txtReportante"></span>)</label>
                    <div style="display:flex; gap:8px; margin-bottom:8px;">
                        <button type="button" onclick="setPuntos(25)" style="padding:4px 8px; font-size:11px; cursor:pointer;">+25</button>
                        <button type="button" onclick="setPuntos(50)" style="padding:4px 8px; font-size:11px; cursor:pointer;">+50</button>
                        <button type="button" onclick="setPuntos(100)" style="padding:4px 8px; font-size:11px; cursor:pointer;">+100</button>
                    </div>
                    <input type="number" id="modalPuntos" name="puntos" value="0" min="0" placeholder="Puntos a otorgar" />
                </div>

                <div class="form-group">
                    <label>Motivo de la asignación / Observaciones</label>
                    <input type="text" name="motivo" placeholder="Ej: Reporte ciudadano validado y publicado" />
                </div>

                <button type="submit" class="btn-submit">Guardar Cambios y Actualizar</button>
            </form>
        </div>
    </div>

    <!-- MODAL 2: Exclusivo para Retos Concluidos (Muestra el Antes y el Después validado por la IA) -->
    <div id="modalAntesDespues" class="modal-overlay">
        <div class="modal-card-wide">
            <button class="modal-close" onclick="cerrarModalAntesDespues()">&times;</button>
            <div style="display:flex; align-items:center; gap:10px; margin-bottom:4px;">
                <h3 id="tituloConcluido" style="color:#1b5e20; font-size:20px;">Evidencia de Reto Concluido</h3>
                <span class="badge b-resuelto">✓ Validado por IA</span>
            </div>
            <p id="infoParticipantesConcluido" style="font-size:13px; color:#4e7d55; font-weight:600; margin-bottom:10px;"></p>

            <div class="comparativa-grid">
                <div class="comparativa-box" style="background:#fef2f2; border:1px solid #fecaca;">
                    <span style="font-size:13px; font-weight:800; color:#b91c1c;">🚨 ANTES: Incidencia Reportada</span>
                    <img id="imgAntesConcluido" src="" alt="Imagen Antes" />
                </div>
                <div class="comparativa-box" style="background:#f0fdf4; border:2px solid #22c55e;">
                    <span style="font-size:13px; font-weight:800; color:#15803d;">✅ DESPUÉS: Solución Validada por IA</span>
                    <img id="imgDespuesConcluido" src="" alt="Imagen Después" />
                </div>
            </div>

            <div style="text-align:right; margin-top:20px;">
                <button type="button" onclick="cerrarModalAntesDespues()"
                        style="background:#1b5e20; color:#fff; border:none; padding:10px 24px; border-radius:8px; font-weight:700; cursor:pointer;">
                    Cerrar Inspección
                </button>
            </div>
        </div>
    </div>

    <script>
            // Se ejecuta cuando el reto está Pendiente o En Proceso
            function abrirModalInspeccion(id, titulo, estatus, idUsuario, reportante, fotoUrl) {
                document.getElementById('modalIdReporte').value = id;
                document.getElementById('modalIdUsuario').value = idUsuario;

                var selectEst = document.getElementById('modalEstatus');
                if (estatus === 'Por Validar') {
                    selectEst.value = 'Pendiente';
                } else {
                    selectEst.value = estatus;
                }

                document.getElementById('txtIncidencia').innerText = `#${id} - ${titulo}`;
                document.getElementById('txtReportante').innerText = reportante || 'Ciudadano';
                document.getElementById('modalPuntos').value = 0;

                var imgFoto = document.getElementById('imgInspeccion');
                imgFoto.src = (fotoUrl && fotoUrl.trim() !== '') ? fotoUrl : 'https://via.placeholder.com/400x220?text=Sin+Imagen+Subida';

                document.getElementById('modalInspeccionar').style.display = 'flex';
            }

            // Se ejecuta cuando el reto ya está Resuelto / Reto Concluido en verde
            function abrirModalAntesDespues(id, titulo, reportante, solucionador, fotoAntes, fotoDespues) {
                document.getElementById('tituloConcluido').innerText = `#${id} - ${titulo}`;
                document.getElementById('infoParticipantesConcluido').innerText =
                    `Reportado por: ${reportante || 'Ciudadano'} | Resuelto y acreditado a: ${solucionador || 'Voluntario'}`;

                document.getElementById('imgAntesConcluido').src = (fotoAntes && fotoAntes.trim() !== '')
                    ? fotoAntes : 'https://via.placeholder.com/400x240?text=Sin+Foto+Inicial';

                document.getElementById('imgDespuesConcluido').src = (fotoDespues && fotoDespues.trim() !== '')
                    ? fotoDespues : 'https://via.placeholder.com/400x240?text=Sin+Foto+de+Solucion';

                document.getElementById('modalAntesDespues').style.display = 'flex';
            }

            function setPuntos(valor) {
                document.getElementById('modalPuntos').value = valor;
            }

            function cerrarModalInspeccion() {
                document.getElementById('modalInspeccionar').style.display = 'none';
            }

            function cerrarModalAntesDespues() {
                document.getElementById('modalAntesDespues').style.display = 'none';
            }
    </script>

</body>
</html>