@{
    Layout = null;
    var nombre = ViewBag.UsuarioNombre ?? "Administrador";
    var iniciales = ViewBag.UsuarioIniciales ?? "AD";
    var rol = ViewBag.UsuarioRol ?? "Administrador";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Catálogo de Retos Ecológicos - ECOTRACK</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', system-ui, sans-serif; }
        body { display: flex; height: 100vh; background: #f4fbf5; color: #143319; }

        .sidebar { width: 260px; min-width: 260px; background: #0f2d18; color: #fff; display: flex; flex-direction: column; justify-content: space-between; }
        .brand-header { padding: 22px; font-size: 20px; font-weight: 800; color: #a3e635; display: flex; align-items: center; justify-content: space-between; }
        .tag-consola { background: #164e28; color: #a3e635; font-size: 10px; padding: 3px 8px; border-radius: 6px; font-weight: 700; }
        .user-card { display: flex; align-items: center; gap: 12px; margin: 0 16px 20px; padding: 12px 14px; background: #143e20; border-radius: 12px; }
        .user-avatar { width: 38px; height: 38px; border-radius: 50%; background: #22c55e; color: #064e1e; display: flex; align-items: center; justify-content: center; font-weight: 800; }
        .menu-heading { font-size: 10px; font-weight: 700; color: #6ee7b7; padding: 12px 22px 6px; text-transform: uppercase; letter-spacing: 0.5px; }
        .menu-link { display: flex; align-items: center; gap: 12px; padding: 10px 22px; color: #d1fae5; text-decoration: none; font-size: 13.5px; font-weight: 600; }
        .menu-link:hover { background: #164e28; color: #fff; }
        .menu-link.active { background: #22c55e; color: #064e1e; font-weight: 800; border-radius: 8px; margin: 0 12px; padding: 10px 14px; }

        .main-content { flex: 1; overflow-y: auto; padding: 28px 34px; }
        .top-bar { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; }

        .panel-box { background: #fff; border-radius: 14px; border: 1px solid #d9e7dc; padding: 22px; box-shadow: 0 2px 8px rgba(0,0,0,0.03); }
        table { width: 100%; border-collapse: collapse; font-size: 13.5px; margin-top: 10px; }
        th, td { padding: 12px 14px; text-align: left; border-bottom: 1px solid #edf4ee; vertical-align: middle; }
        th { background: #f4fbf5; color: #2e5934; font-weight: 700; }

        .badge { padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; display: inline-block; }
        .b-validar { background: #fef3c7; color: #b45309; }
        .b-activo { background: #e0f2fe; color: #0369a1; }
        .b-completado { background: #dcfce7; color: #15803d; }

        .btn-validar { padding: 6px 12px; border-radius: 6px; font-weight: 700; font-size: 12px; cursor: pointer; border: none; background: #1b5e20; color: #fff; }
        .btn-validar:hover { background: #143e20; }

        .btn-evidencia { padding: 6px 12px; border-radius: 6px; font-weight: 700; font-size: 12px; cursor: pointer; border: 1px solid #15803d; background: #dcfce7; color: #14532d; }
        .btn-evidencia:hover { background: #15803d; color: #fff; }

        .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 2000; justify-content: center; align-items: center; padding: 15px; }
        .modal-card { background: #fff; width: 100%; max-width: 740px; border-radius: 16px; padding: 24px; position: relative; max-height: 92vh; overflow-y: auto; }
        .modal-close { position: absolute; top: 16px; right: 18px; font-size: 22px; border: none; background: transparent; cursor: pointer; font-weight: bold; color: #555; }
        .evidencia-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 14px; }
        .evidencia-box { padding: 12px; border-radius: 12px; text-align: center; }
        .evidencia-box img { width: 100%; height: 230px; object-fit: cover; border-radius: 8px; margin-top: 8px; background: #f1f5f9; }
    </style>
</head>
<body>

<aside class="sidebar">
    <div>
        <div class="brand-header">
            ECOTRACK <span class="tag-consola">CONSOLA</span>
        </div>
        <div class="user-card">
            <div class="user-avatar">@iniciales</div>
            <div>
                <div style="font-size:13.5px; font-weight:700; color:#fff;">@nombre</div>
                <div style="font-size:10.5px; color:#a3e635; font-weight:700;">@rol</div>
            </div>
        </div>
        <div class="menu-heading">Centro de Mando</div>
        <a href="/Admin/Index" class="menu-link">📊 Tablero Resumen</a>
        <a href="/Reportes/Index" class="menu-link">🗺️ Vista Ciudadana / Mapa</a>
        
        <div class="menu-heading">Control de Base de Datos</div>
        <a href="/Admin/Usuarios" class="menu-link">👥 Auditoría de Usuarios</a>
        <a href="/Admin/Retos" class="menu-link active">🌱 Catálogo de Retos</a>
        <a href="/Admin/Participantes" class="menu-link">🤝 Registro Participantes</a>
        <a href="/Admin/Puntos" class="menu-link">🏆 Control de Puntos</a>
    </div>
    <div style="padding: 18px 22px; border-top: 1px solid #143e20;">
        <a href="/Usuarios/CerrarSesion" style="color: #f87171; text-decoration:none; font-size:13px; font-weight:600;">🚪 Cerrar Sesión</a>
    </div>
</aside>

<main class="main-content">
    <div class="top-bar">
        <div>
            <h2 style="font-size: 24px; color: #1b5e20;">Catálogo de Retos Ecológicos</h2>
            <p style="font-size: 13px; color: #4e7d55;">Validación de retos para publicación en el mapa y revisión de evidencias fotográficas de solución</p>
        </div>
    </div>

    <div class="panel-box">
        <table>
            <thead>
                <tr>
                    <th>id_reto</th>
                    <th>Reporte Origen</th>
                    <th>Título</th>
                    <th>Recompensa</th>
                    <th>Vigencia</th>
                    <th>Estado</th>
                    <th>Control / Evidencia</th>
                </tr>
            </thead>
            <tbody>
                @if (ViewBag.Retos != null)
                {
                    foreach (var r in ViewBag.Retos)
                    {
                        string estLower = (r.Estado ?? "").ToString().ToLower();
                        var badgeClase = (estLower == "por validar" || estLower == "pendiente") ? "b-validar" : (estLower == "completado" || estLower == "resuelto" ? "b-completado" : "b-activo");

                        <tr>
                            <td>#@r.Id</td>
                            <td>Reporte #@r.IdReporteOrigen</td>
                            <td><b>@r.Titulo</b></td>
                            <td style="color:#15803d; font-weight:800;">+@r.Puntos pts</td>
                            <td>@r.Inicio al @r.Fin</td>
                            <td><span class="badge @badgeClase">@r.Estado</span></td>
                            <td>
                                @if (estLower == "por validar" || estLower == "pendiente")
                                {
                                    <form method="post" action="/Admin/ValidarRetoDirecto" style="margin:0;">
                                        <input type="hidden" name="id_reto" value="@r.Id" />
                                        <input type="hidden" name="id_reporte_origen" value="@r.IdReporteNum" />
                                        <button type="submit" class="btn-validar" 
                                                onclick="return confirm('¿Validar este reto ecológico para que se publique en el mapa ciudadano?');">
                                            ✓ Validar para Publicar
                                        </button>
                                    </form>
                                }
                                else if (estLower == "completado" || estLower == "resuelto")
                                {
                                    <button type="button" class="btn-evidencia"
                                            onclick="abrirModalEvidencia('@Html.Raw(r.Titulo.Replace("'", "\\'"))', '@Html.Raw(r.Solucionador.Replace("'", "\\'"))', '@r.FotoAntes', '@r.FotoSolucion')">
                                        📷 Ver Evidencia Solución
                                    </button>
                                }
                                else
                                {
                                    <span style="font-size:12px; font-weight:700; color:#0369a1;">🗺️ Publicado en Mapa</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</main>

<!-- Modal para observar la evidencia fotográfica con la que se solucionó el reto -->
<div id="modalEvidencia" class="modal-overlay">
    <div class="modal-card">
        <button class="modal-close" onclick="cerrarModalEvidencia()">&times;</button>
        <h3 id="tituloModalReto" style="color:#1b5e20; margin-bottom:4px;">Evidencia de Solución del Reto</h3>
        <p id="subtituloSolucionador" style="font-size:13px; color:#4e7d55; font-weight:700; margin-bottom:12px;"></p>

        <div class="evidencia-grid">
            <div class="evidencia-box" style="background:#fef2f2; border:1px solid #fecaca;">
                <span style="font-size:12.5px; font-weight:800; color:#b91c1c;">🚨 Problema Reportado (Antes)</span>
                <img id="imgAntesModal" src="" alt="Evidencia inicial" />
            </div>
            <div class="evidencia-box" style="background:#f0fdf4; border:2px solid #22c55e;">
                <span style="font-size:12.5px; font-weight:800; color:#15803d;">✅ Evidencia con la que se Solucionó (Después)</span>
                <img id="imgDespuesModal" src="" alt="Evidencia de solución" />
            </div>
        </div>

        <div style="text-align:right; margin-top:18px;">
            <button type="button" onclick="cerrarModalEvidencia()" 
                    style="background:#143319; color:#fff; border:none; padding:9px 20px; border-radius:8px; font-weight:700; cursor:pointer;">
                Cerrar Vista
            </button>
        </div>
    </div>
</div>

<script>
    function abrirModalEvidencia(titulo, solucionador, fotoAntes, fotoSolucion) {
        document.getElementById('tituloModalReto').innerText = titulo;
        document.getElementById('subtituloSolucionador').innerText = "Solucionado por: " + (solucionador || "Voluntario Comunitario");

        var imgA = document.getElementById('imgAntesModal');
        var imgD = document.getElementById('imgDespuesModal');

        imgA.src = (fotoAntes && fotoAntes.trim() !== '') ? fotoAntes : 'https://via.placeholder.com/400x250?text=Sin+Foto+Inicial';
        imgD.src = (fotoSolucion && fotoSolucion.trim() !== '') ? fotoSolucion : 'https://via.placeholder.com/400x250?text=Sin+Foto+de+Solucion';

        document.getElementById('modalEvidencia').style.display = 'flex';
    }

    function cerrarModalEvidencia() {
        document.getElementById('modalEvidencia').style.display = 'none';
    }
</script>

</body>
</html>