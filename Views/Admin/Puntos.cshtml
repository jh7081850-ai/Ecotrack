@{
    Layout = null;
    var nombre = ViewBag.UsuarioNombre ?? "Administrador";
    var iniciales = ViewBag.UsuarioIniciales ?? "AD";
    var rol = ViewBag.UsuarioRol ?? "Administrador";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Control de Puntos - ECOTRACK</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', system-ui, sans-serif; }
        body { display: flex; height: 100vh; background: #f4fbf5; color: #143319; }
        .sidebar { width: 260px; min-width: 260px; background: #0f2d18; color: #fff; display: flex; flex-direction: column; justify-content: space-between; }
        .brand-header { padding: 22px; font-size: 20px; font-weight: 800; color: #a3e635; }
        .user-card { display: flex; align-items: center; gap: 12px; margin: 0 16px 20px; padding: 12px 14px; background: #143e20; border-radius: 12px; }
        .user-avatar { width: 38px; height: 38px; border-radius: 50%; background: #22c55e; color: #064e1e; display: flex; align-items: center; justify-content: center; font-weight: 800; }
        .menu-heading { font-size: 10px; font-weight: 700; color: #6ee7b7; padding: 12px 22px 6px; text-transform: uppercase; }
        .menu-link { display: flex; align-items: center; gap: 12px; padding: 10px 22px; color: #d1fae5; text-decoration: none; font-size: 13.5px; font-weight: 600; }
        .menu-link:hover { background: #164e28; color: #fff; }
        .menu-link.active { background: #22c55e; color: #064e1e; font-weight: 800; border-radius: 8px; margin: 0 12px; padding: 10px 14px; }
        .main-content { flex: 1; overflow-y: auto; padding: 28px 34px; }
        .panel-box { background: #fff; border-radius: 14px; border: 1px solid #d9e7dc; padding: 22px; }
        table { width: 100%; border-collapse: collapse; font-size: 13.5px; margin-top: 15px; }
        th, td { padding: 12px 14px; text-align: left; border-bottom: 1px solid #edf4ee; }
        th { background: #f4fbf5; color: #2e5934; font-weight: 700; }
        .pts-tag { color: #15803d; font-weight: 800; }
    </style>
</head>
<body>
<aside class="sidebar">
    <div>
        <div class="brand-header">ECOTRACK <span style="font-size:10px; background:#164e28; padding:3px 8px; border-radius:6px;">CONSOLA</span></div>
        <div class="user-card">
            <div class="user-avatar">@iniciales</div>
            <div>
                <div style="font-size:13.5px; font-weight:700;">@nombre</div>
                <div style="font-size:10.5px; color:#a3e635; font-weight:700;">@rol</div>
            </div>
        </div>
        <div class="menu-heading">Centro de Mando</div>
        <a href="/Admin/Index" class="menu-link">📊 Tablero Resumen</a>
        <a href="/Reportes/Index" class="menu-link">🗺️ Vista Ciudadana / Mapa</a>
        <div class="menu-heading">Control de Base de Datos</div>
        <a href="/Admin/Usuarios" class="menu-link">👥 Auditoría de Usuarios</a>
        <a href="/Admin/Retos" class="menu-link">🌱 Catálogo de Retos</a>
        <a href="/Admin/Participantes" class="menu-link">🤝 Registro Participantes</a>
        <a href="/Admin/Puntos" class="menu-link active">🏆 Control de Puntos</a>
    </div>
    <div style="padding: 18px 22px; border-top: 1px solid #143e20;">
        <a href="/Usuarios/CerrarSesion" style="color: #f87171; text-decoration:none; font-size:13px; font-weight:600;">🚪 Cerrar Sesión</a>
    </div>
</aside>

<main class="main-content">
    <h2 style="font-size: 24px; color: #1b5e20;">Auditoría de Transacciones de Puntos</h2>
    <p style="font-size: 13px; color: #4e7d55; margin-bottom: 22px;">Movimientos contables registrados en HISTORIAL_PUNTOS de Neon</p>
    <div class="panel-box">
        <table>
            <thead>
                <tr>
                    <th>id_transaccion</th>
                    <th>Ciudadano</th>
                    <th>puntos</th>
                    <th>motivo</th>
                    <th>Reto / Reporte</th>
                    <th>fecha</th>
                </tr>
            </thead>
            <tbody>
                @if (ViewBag.Transacciones != null)
                {
                    foreach (var t in ViewBag.Transacciones)
                    {
                        <tr>
                            <td>#@t.Id</td>
                            <td style="font-weight:700;">@t.Ciudadano</td>
                            <td class="pts-tag">+@t.Puntos pts</td>
                            <td>@t.Motivo</td>
                            <td>@t.Reto</td>
                            <td>@t.Fecha</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</main>
</body>
</html>